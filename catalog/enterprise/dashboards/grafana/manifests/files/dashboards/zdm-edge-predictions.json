{
  "uid": "zdm-edge-predictions",
  "title": "ZDM: Edge Predictions and Model Versions",
  "description": "Edge data stock: prediction log, version history of edge version control and operator feedback records.",
  "tags": [
    "iso42001",
    "zdm",
    "edge",
    "predictions",
    "cmp-03"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "timezone": "browser",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Predictions by label (per minute)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "edgepg"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "rawSql": "SELECT date_trunc('minute', timestamp) AS time, label AS metric, count(*) AS value\nFROM predictions WHERE $__timeFilter(timestamp) GROUP BY 1, 2 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "edgepg"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Model version history at the edge",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "edgepg"
      },
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "rawSql": "SELECT received_at, model_name, model_version, status, alias, run_id, artefact_sha256\nFROM model_versions ORDER BY id DESC LIMIT 20",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "edgepg"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Latest predictions",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "edgepg"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "rawSql": "SELECT timestamp, machine_id, model_version, round(score::numeric, 4) AS score, label\nFROM predictions ORDER BY id DESC LIMIT 50",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "edgepg"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Operator feedback records",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "edgepg"
      },
      "description": "Read-only view of the operator_feedback table; this catalog ships no feedback capture interface (CMP-12).",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "rawSql": "SELECT f.timestamp, f.operator_id, f.feedback_type, f.comment, p.model_version, p.label\nFROM operator_feedback f LEFT JOIN predictions p ON p.id = f.prediction_id ORDER BY f.id DESC LIMIT 50",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "edgepg"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
