{
  "uid": "zdm-data-drift",
  "title": "ZDM: Data Consolidation, KPIs and Drift (CMP-02, CMP-11, CMP-14)",
  "description": "Platform data stock (TimescaleDB): consolidation batches from the edge, OEE KPIs and retraining recommendations.",
  "tags": [
    "iso42001",
    "zdm",
    "data",
    "drift",
    "cmp-02",
    "cmp-11",
    "cmp-14"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Rows consolidated from the edge (per 5 min)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "rawSql": "SELECT time_bucket('5 minutes', finished_at) AS time, source_table AS metric, sum(rows_written) AS value\nFROM consolidation_batches WHERE status = 'ok' AND $__timeFilter(finished_at)\nGROUP BY 1, 2 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Last consolidation batches",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "rawSql": "SELECT id, site_id, source_table, from_id, to_id, rows_read, rows_written, status, finished_at\nFROM consolidation_batches ORDER BY id DESC LIMIT 20",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Share of drifted features",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "rawSql": "SELECT created_at AS time, drift_share AS \"drift share\", threshold AS \"threshold\"\nFROM retraining_recommendations WHERE $__timeFilter(created_at) ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Retraining recommendations",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "rawSql": "SELECT created_at, model_name, model_version, round(drift_share::numeric, 3) AS drift_share, drifted_columns, recommended, action, report_uri\nFROM retraining_recommendations ORDER BY id DESC LIMIT 20",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "OEE by machine (B.6.2.6.3)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "description": "Goal-oriented KPI; fed by the plant systems (empty until an OEE source writes oee_kpis).",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "rawSql": "SELECT time, machine_id AS metric, oee AS value FROM oee_kpis WHERE $__timeFilter(time) ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
